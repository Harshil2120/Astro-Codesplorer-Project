---
import NavLink from './NavLink.astro';
import ButtonComp from './ButtonComp.astro';
import GithubButton from './GithubButton.astro';

const nav = [
	{
		link: '/blogs/',
		label: 'Blogs'
	},
	{
		link: '/projects/',
		label: 'Projects'
	},
	{
		link: '/author/',
		label: 'Author'
	}
];
---

<header class='w-full z-20 absolute'>
	<nav role='navigation' class='flex text-black dark:text-white px-3 justify-between items-center py-3 max-w-5xl mx-auto'>
		<a href='/' class='flex text-2xl md:text-2xl font-mono items-center space-x-2'>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				width='30'
				height='30'
				viewBox='0 0 24 24'
				fill='none'
				stroke='currentColor'
				stroke-width='2'
				stroke-linecap='round'
				stroke-linejoin='round'
				class='lucide lucide-rocket w-[27px] h-[27px] md:w-[30px] md:h-[30px]'
				><path d='M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z'></path><path
					d='m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z'></path><path
					d='M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0'></path><path d='M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5'></path></svg
			>
			<p class='font-mono'><b>CodeSplorer</b></p>
		</a>
		<div class='flex space-x-3 md:space-x-5'>
			<ButtonComp />
			<GithubButton />
		</div>
	</nav>
	<div class='fixed top-2 hidden md:block left-1/2 -translate-x-1/2 max-w-[90%] md:max-w-[80%]'>
		<div
			class='flex p-1 bg-zinc-100/85 dark:bg-black/55 dark:backdrop-blur-sm backdrop-blur-sm leading-tight rounded-xl border border-zinc-400 dark:border-zinc-500'
		>
			<div class='text-sm'>
				<NavLink class='py-2 flex items-center px-2 border-[1px] rounded-lg' href='/' aria-label='Home' aria-current='page'>
					<svg
						xmlns='http://www.w3.org/2000/svg'
						width='20'
						height='20'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='2.0'
						stroke-linecap='round'
						stroke-linejoin='round'
						class='lucide lucide-house'
						aria-hidden='true'
					>
						<path d='M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8'></path>
						<path d='M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'></path>
					</svg>
				</NavLink>
			</div>
			{
				nav.map((item) => (
					<div class='text-base'>
						<NavLink class='py-1.5 flex items-center px-2 rounded-lg font-medium border-[1px]' href={item.link}>
							{item.label}
						</NavLink>
					</div>
				))
			}
		</div>
	</div>

	<div class='fixed bottom-2 md:hidden left-1/2 -translate-x-1/2 max-w-[90%] md:max-w-[80%]'>
		<div
			class='flex px-2.5 bg-white/55 dark:bg-black/75 backdrop-blur-md leading-tight rounded-xl border border-zinc-300 dark:border-zinc-500'
		>
			<div class='px-2.5 text-sm'>
				<NavLink class='py-3 flex items-center' href='/' aria-label='Home'>
					<svg
						xmlns='http://www.w3.org/2000/svg'
						width='20'
						height='20'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='1.7'
						stroke-linecap='round'
						stroke-linejoin='round'
						class='lucide lucide-house'
						aria-hidden='true'
					>
						<path d='M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8'></path>
						<path d='M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'></path>
					</svg>
				</NavLink>
			</div>
			{
				nav.map((item) => (
					<div class='px-3 md:px-4 text-base'>
						<NavLink class='py-2.5 flex items-center' href={item.link}>
							{item.label}
						</NavLink>
					</div>
				))
			}
		</div>
	</div>
</header>

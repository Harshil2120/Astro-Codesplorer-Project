---
import { type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
type Props = {
	post: CollectionEntry<'posts'>;
};

const { post } = Astro.props;

const lightImage = post.data.image;
---

<article class='rounded-xl bg-zinc-100 dark:bg-zinc-950 border-zinc-400 border-[1px] text-black dark:text-zinc-200'>
	<!-- <Image src={post.data.image} alt={post.data.title} class='p-2 rounded-2xl h-56 md:h-72' /> -->
	<Image src={lightImage} alt={post.data.title} class='p-2 rounded-2xl h-56 md:h-72 w-full object-cover' />

	<div class='p-4 space-y-3'>
		<a href={`/${post.slug}`} class='text-xl font-mono'>{post.data.title}</a>
		<div class='flex justify-between items-end'>
			<div class='flex flex-wrap gap-2'>
				{
					post.data.categories?.length ? (
						post.data.categories.map((category: string) => (
							<span class='px-3 py-1 text-sm font-mono text-zinc-900 dark:text-zinc-200 bg-zinc-300 dark:bg-zinc-800 rounded-full'>
								{category}
							</span>
						))
					) : (
						<p class='text-gray-500 text-sm font-mono'>No categories available</p>
					)
				}
			</div>
			<div>
				<p class='text-gray-500 text-sm font-mono text-right'>
					{
						post.data.date.toLocaleDateString('en-us', {
							year: 'numeric',
							month: 'long',
							day: '2-digit'
						})
					}
				</p>
			</div>
		</div>
	</div>
</article>

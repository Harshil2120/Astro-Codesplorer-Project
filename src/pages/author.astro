---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Label from '../components/Label.astro';
import SkillLayout from '../components/SkillLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Personal information - centralized for easier updates
const personalInfo = {
	name: 'Harshil Donga',
	status: 'Actively Looking for Full-time Opportunities',
	statusUrl: 'https://github.com/srleom/astro-theme-resume.git',
	location: 'Atlanta, GA, USA',
	education: 'MS CS 2025',
	position: 'Graduate Research Assistant @GSU',
	linkedin: 'https://www.linkedin.com/in/harshil-donga/',
	email: 'hdonga212@gmail.com'
};

// Skills data
const skills = {
	languages: ['Html', 'Css', 'Javascript', 'Vite', 'ReactJS', 'NextJS', 'TailwindCss', 'Shadcn', 'Bootstrap', 'ChartJS', 'Astro'],
	frontend: [
		'Java',
		'Maven',
		'Spring Boot',
		'SpringMVC',
		'NodeJS',
		'Express',
		'Flask',
		'Kafka',
		'BullMQ',
		'Redis',
		'MySQL',
		'MongoDB',
		'REST APIs',
		'GraphQL',
		'Webhooks',
		'Websockets',
		'NextAuth',
		'Nginx',
		'JUnit'
	],
	backend: ['AWS', 'Azure', 'Docker', 'Git', 'Github', 'Github Actions CI/CD', 'Grafana', 'Loki', 'Prometheus', 'K6 Testing'],
	others: ['Fundamentals of Machine Learning', 'Langchain', 'Langsmith', 'LLMs', 'VectorDB', 'GraphDB']
};

// Experience data
const experiences = [
	{
		company: 'SWAN-AI Research Group',
		position: 'AI Software Engineer',
		period: 'Aug 2023 - May 2025',
		logo: '/src/assets/swan.jpg',
		responsibilities: [
			'Developed and Architected an AI-powered RAG Chatbot application for individuals with anxiety disorders as a part of research work. The application had features like user-authentication, real-time notifications, and interactive metrics visualization with dynamic graphs.',
			'Also worked on deploying LLMs locally on GPU-servers and working with AI frameworks like LangChain for building AI-driven applications. Additionally, built data and image annotation tools using Next.js, React Forms, and MongoDB to assist PhD students and professors in collecting high-quality datasets for AI/ML research work.'
		]
	},
	{
		company: 'Accenture',
		position: 'Associate Software Engineer',
		period: 'Sept 2021 - June 2023',
		logo: '/src/assets/accenture_logo.png',
		responsibilities: [
			'Developed microservices using Test-Driven Development with Maven, Java, Spring Boot and JUnit. Integrated third-party APIs such as Twilio and Microsoft EWS API for sending emails and notifications.',
			'Optimized REST APIs performance by reducing latency from 295ms to 85ms through Redis caching. Additionally, documented it using Swagger, ensuring clear API specifications for integration and usage',
			'Implemented observability using the LGTM (Loki, Grafana, Tempo, Prometheus) stack for centralizedlogging,metrics, and distributed tracing, which improved system monitoring, troubleshooting, andperformance analysis by monitoring application performance using Grafana dashboards.',
			'Collaborated with automation team in writing scripts and CRON jobs for generating automated reports about health hecks of applications which helped management in keeping track of SLAs. These were deployed on AWS EC2 and monitored using AWS Cloudwatch.'
		]
	}
];

// Education data
const education = [
	{
		institution: 'Georgia State University',
		degree: "Master's degree, Computer Science",
		period: 'Aug 2023 - May 2025',
		logo: '/src/assets/gsu_logo.jpg'
	},
	{
		institution: 'Pune University',
		degree: "Bachelor's degree, Computer Engineering",
		period: 'Aug 2017 - June 2021',
		logo: '/src/assets/sppu.jpg'
	}
];

// Projects data
const projects = [
	{
		title: 'Implementation of Consistent Hashing Algorithm using AWS',
		description: '',
		image: '/src/assets/consistent.png',
		url: 'https://www.google.com'
	},
	{
		title: 'RAG Chatbot Application using LangChain, Ollama and Next.js',
		description: '',
		image: '/src/assets/rag.png',
		url: null
	}
];

// Certifications data
const certifications = [
	{
		name: 'AWS Certified Cloud Practitioner',
		description:
			'Gained foundational knowledge of AWS services like AWS EC2, S3, RDS, Lambda, DynamoDB. Also learned about cloud concepts, IAM, billing, monitoring, security, and compliance.',
		period: 'Jan 2025 - Jan 2028',
		logo: '/src/assets/aws_logo.png',
		url: 'https://www.credly.com/badges/c94f9592-c6e2-41e3-8b27-a39e64ac5559/public_url'
	},
	{
		name: 'Docker Foundations Professional Certificate',
		description:
			'Developed skills in containerization with Docker, like creating and managing images, containers, and registries. Gained hands-on experience with Docker CLI, Docker Compose, networking, and security best practices.',
		period: 'Sep-2024',
		logo: '/src/assets/docker.jpg',
		url: 'https://www.google.com'
	}
];
---

<Layout title={`${personalInfo.name} - Portfolio`}>
	<div
		class='flex max-w-5xl mx-auto flex-col gap-y-4 sm:gap-y-10 border-[1px] border-zinc-400 dark:text-white dark:bg-zinc-700/40 bg-zinc-100/85 p-4 sm:p-6 sm:px-8 rounded-xl'
	>
		<!-- Header Section with Personal Information -->
		<section class='flex flex-col items-center gap-y-5 sm:gap-y-7'>
			<div class='flex flex-col items-center gap-y-3 sm:gap-y-4'>
				<h1 class='text-2xl sm:text-3xl font-bold'>{personalInfo.name}</h1>

				<!-- Status Badge -->
				<a
					href={personalInfo.statusUrl}
					class='flex flex-row items-center bg-zinc-100 dark:bg-zinc-900 gap-x-2 sm:gap-x-3 rounded-3xl border-[1px] border-zinc-400 px-3 sm:px-4 py-1 sm:py-2 text-xs sm:text-sm shadow-sm hover:shadow-md'
				>
					<span class='relative flex items-center justify-center'>
						<span
							class='absolute inline-flex h-1.5 w-1.5 sm:h-2 sm:w-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
						></span>
						<span class='relative inline-flex h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-green-400'></span>
					</span>
					<p class='font-medium'>{personalInfo.status}</p>
				</a>

				<!-- Personal Details -->
				<div class='flex flex-col flex-wrap justify-center space-y-3'>
					<!-- Education & Location -->
					<div class='flex flex-wrap justify-center gap-2 sm:gap-4'>
						<Label title={personalInfo.education}>
							<svg
								xmlns='http://www.w3.org/2000/svg'
								width='20'
								height='20'
								viewBox='0 0 24 24'
								fill='none'
								stroke='currentColor'
								stroke-width='1'
								stroke-linecap='round'
								stroke-linejoin='round'
								class='lucide lucide-graduation-cap'
								slot='icon'
							>
								<path
									d='M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z'
								></path>
								<path d='M22 10v6'></path>
								<path d='M6 12.5V16a6 3 0 0 0 12 0v-3.5'></path>
							</svg>
						</Label>

						<Label title={personalInfo.position}>
							<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' class='h-4 w-4 sm:h-5 sm:w-5' slot='icon'>
								<path
									fill='currentColor'
									d='M4.615 20q-.69 0-1.152-.462Q3 19.075 3 18.385v-9.77q0-.69.463-1.152Q3.925 7 4.615 7H9V5.615q0-.69.463-1.152Q9.925 4 10.615 4h2.77q.69 0 1.153.463q.462.462.462 1.152V7h4.385q.69 0 1.152.463q.463.462.463 1.152v9.77q0 .69-.462 1.152q-.463.463-1.153.463zm0-1h14.77q.23 0 .423-.192q.192-.193.192-.423v-9.77q0-.23-.192-.423Q19.615 8 19.385 8H4.615q-.23 0-.423.192Q4 8.385 4 8.615v9.77q0 .23.192.423q.193.192.423.192M10 7h4V5.615q0-.23-.192-.423Q13.615 5 13.385 5h-2.77q-.23 0-.423.192q-.192.193-.192.423zM4 19V8z'
								></path>
							</svg>
						</Label>

						<Label title={personalInfo.location}>
							<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' class='h-4 w-4 sm:h-5 sm:w-5' slot='icon'>
								<path
									fill='currentColor'
									d='M12.003 11.73q.668 0 1.14-.475q.472-.475.472-1.143t-.475-1.14q-.476-.472-1.143-.472t-1.14.476q-.472.475-.472 1.143t.475 1.14q.476.472 1.143.472M12 19.677q2.82-2.454 4.458-4.991q1.638-2.538 1.638-4.39q0-2.744-1.737-4.53T12 3.981q-2.621 0-4.359 1.785t-1.737 4.53q0 1.852 1.638 4.39q1.639 2.537 4.458 4.99m0 1.343q-3.525-3.117-5.31-5.814q-1.786-2.697-1.786-4.909q0-3.173 2.066-5.234Q9.037 3 12 3t5.03 2.062q2.066 2.061 2.066 5.234q0 2.212-1.785 4.909q-1.786 2.697-5.311 5.814m0-10.904'
								></path>
							</svg>
						</Label>
					</div>

					<!-- Contact Links -->
					<div class='flex justify-center gap-2 sm:gap-4'>
						<Label title='Linkedin' as='a' href={personalInfo.linkedin} target='_blank'>
							<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' slot='icon' class='h-4 w-4 sm:h-5 sm:w-5 text-foreground/75'>
								<path
									fill='currentColor'
									d='M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248c-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586c.173-.431.568-.878 1.232-.878c.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252c-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z'
								></path>
							</svg>
						</Label>

						<Label title={personalInfo.email} as='a' href={`mailto:${personalInfo.email}`} target='_blank'>
							<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' slot='icon' class='h-4 w-4 sm:h-5 sm:w-5 text-foreground/75'>
								<path
									fill='currentColor'
									d='M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5l-8-5V6l8 5l8-5v2z'></path>
							</svg>
						</Label>
					</div>
				</div>
			</div>
		</section>

		<!-- Experience Section -->
		<Section title='Work Experience'>
			{
				experiences.map((exp) => (
					<Card
						heading={exp.position}
						subheading={exp.company}
						date={exp.period}
						imagePath={exp.logo}
						altText={`${exp.company} logo`}
						imageClass='h-12 sm:h-16 w-auto md:-left-16 rounded-xl'>
						<ul class='ml-4 list-disc text-muted-foreground'>
							{exp.responsibilities.map((item) => (
								<li class='text-justify p-1'>{item}</li>
							))}
						</ul>
					</Card>
				))
			}
		</Section>

		<!-- Skills Section -->
		<Section class='relative rounded-2xl border-[1px] border-zinc-400 bg-primary-foreground p-6'>
			<SkillLayout title='Front-End Skills:' skills={skills.languages} />
			<SkillLayout title='Back-End Skills:' skills={skills.frontend} />
			<SkillLayout title='Cloud & Devops Skills:' skills={skills.backend} />
			<SkillLayout title='ML & AI Skills:' skills={skills.others} />
		</Section>

		<!-- Education Section -->
		<Section title='Education'>
			<div class='flex flex-col gap-y-3 sm:flex-row sm:gap-x-3 sm:gap-y-0'>
				{
					education.map((edu) => (
						<Card
							heading={edu.institution}
							subheading={edu.degree}
							date={edu.period}
							imagePath={edu.logo}
							altText={`${edu.institution} logo`}
							imageClass='h-12 sm:h-16 w-auto md:-left-16 rounded-xl'
						/>
					))
				}
			</div>
		</Section>

		<!-- Projects Section -->
		<Section title='Projects'>
			<div class='flex flex-col gap-y-3 sm:flex-row sm:gap-x-3 sm:gap-y-0'>
				{
					projects.map((project) =>
						project.url ? (
							<ProjectCard
								href={project.url}
								heading={project.title}
								subheading={project.description}
								imagePath={project.image}
								altText={project.title}
								class='w-full sm:w-1/2'
							/>
						) : (
							<ProjectCard
								as='div'
								heading={project.title}
								subheading={project.description}
								imagePath={project.image}
								altText={project.title}
								class='w-full sm:w-1/2'
							/>
						)
					)
				}
			</div>
		</Section>

		<!-- Certifications Section -->
		<Section title='Certifications'>
			{
				certifications.map((cert) => (
					<Card
						as='a'
						heading={cert.name}
						subheading={cert.description}
						date={cert.period}
						imagePath={cert.logo}
						altText={`${cert.name} logo`}
						imageClass='h-10 sm:h-20 w-auto md:-left-16 rounded-xl'
						href={cert.url}
						target='_blank'
					/>
				))
			}
		</Section>
	</div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Label from '../components/Label.astro';
import SkillLayout from '../components/SkillLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Image } from 'astro:assets';

const languages = ['lorem', 'ipsum'];
const frontend = ['lorem', 'ipsum', 'lorem', 'ipsum', 'lorem', 'ipsum', 'lorem'];
const backend = ['lorem', 'ipsum', 'lorem', 'ipsum'];
const others = ['lorem', 'ipsum', 'lorem', 'ipsum', 'lorem'];
---

<Layout title='Welcome to Astro.'>
	<div class='flex max-w-5xl mx-auto flex-col gap-y-10 dark:text-white dark:bg-zinc-800 p-6 px-8 rounded-xl'>
		<section class='flex flex-col items-center gap-y-7'>
			<!-- <Image src={astro} alt='profile photo' class='h-28 w-auto rounded-full bg-[#FFBE98] p-2' loading='eager' /> -->

			<div class='flex flex-col items-center gap-y-4'>
				<h1 class='text-3xl font-bold'>Harshil Donga</h1>
				<a
					href='https://github.com/srleom/astro-theme-resume.git'
					class='flex flex-row items-center gap-x-3 rounded-3xl border border-input px-4 py-2 text-sm shadow-sm transition-all hover:shadow-md'
				>
					<span class='relative flex items-center justify-center'>
						<span class='absolute inline-flex h-2 w-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'></span>
						<span class='relative inline-flex h-2 w-2 rounded-full bg-green-400'></span>
					</span>

					<p class='font-medium'>Actively Looking for Full-time Opportunities</p>
				</a>
				<div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
					<Label title='MS CS 2025'>
						<svg
							xmlns='http://www.w3.org/2000/svg'
							width='24'
							height='24'
							viewBox='0 0 24 24'
							fill='none'
							stroke='currentColor'
							stroke-width='1'
							stroke-linecap='round'
							stroke-linejoin='round'
							class='lucide lucide-graduation-cap'
							slot='icon'
							><path
								d='M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z'
							></path><path d='M22 10v6'></path><path d='M6 12.5V16a6 3 0 0 0 12 0v-3.5'></path></svg
						>
					</Label>
					<Label title='Graduate Research Assistant @GSU'>
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' class='h-5 w-5' slot='icon'
							><path
								fill='currentColor'
								d='M4.615 20q-.69 0-1.152-.462Q3 19.075 3 18.385v-9.77q0-.69.463-1.152Q3.925 7 4.615 7H9V5.615q0-.69.463-1.152Q9.925 4 10.615 4h2.77q.69 0 1.153.463q.462.462.462 1.152V7h4.385q.69 0 1.152.463q.463.462.463 1.152v9.77q0 .69-.462 1.152q-.463.463-1.153.463zm0-1h14.77q.23 0 .423-.192q.192-.193.192-.423v-9.77q0-.23-.192-.423Q19.615 8 19.385 8H4.615q-.23 0-.423.192Q4 8.385 4 8.615v9.77q0 .23.192.423q.193.192.423.192M10 7h4V5.615q0-.23-.192-.423Q13.615 5 13.385 5h-2.77q-.23 0-.423.192q-.192.193-.192.423zM4 19V8z'
							></path></svg
						>
					</Label>
					<Label title='Atlanta, GA, USA'>
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' class='h-5 w-5' slot='icon'
							><path
								fill='currentColor'
								d='M12.003 11.73q.668 0 1.14-.475q.472-.475.472-1.143t-.475-1.14q-.476-.472-1.143-.472t-1.14.476q-.472.475-.472 1.143t.475 1.14q.476.472 1.143.472M12 19.677q2.82-2.454 4.458-4.991q1.638-2.538 1.638-4.39q0-2.744-1.737-4.53T12 3.981q-2.621 0-4.359 1.785t-1.737 4.53q0 1.852 1.638 4.39q1.639 2.537 4.458 4.99m0 1.343q-3.525-3.117-5.31-5.814q-1.786-2.697-1.786-4.909q0-3.173 2.066-5.234Q9.037 3 12 3t5.03 2.062q2.066 2.061 2.066 5.234q0 2.212-1.785 4.909q-1.786 2.697-5.311 5.814m0-10.904'
							></path></svg
						>
					</Label>
					<Label title='Linkedin' as='a' href='https://www.linkedin.com/in/harshil-donga/' target='_blank'>
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' slot='icon' class='h-5 w-5 text-foreground/75'
							><path
								fill='currentColor'
								d='M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248c-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586c.173-.431.568-.878 1.232-.878c.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252c-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z'
							></path></svg
						>
					</Label>
				</div>
			</div>
		</section>

		<Section title='Experience'>
			<Card
				heading='Graduate Research Assistant'
				subheading='Georgia State University'
				date='Aug 2023 - May 2025'
				imagePath='/src/assets/gsu_logo.jpg'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16 rounded-xl'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li class='text-justify'>
						Responsible for designing and developing an AI-powered chatbot application leveraging large language models (LLMs), deployed on
						on-premise, GPU-accelerated servers. The chatbot is for individuals with anxiety disorders and features like data visualization
						as well as alerting administrators based on metrics evaluated from model responses and user prompts.
					</li>
					<li class='text-justify'>
						Additionally, developed text and image annotation tools, which assisted PhD students working as AI/ML Researchers in gathering
						data and evaluating model responses, enabling more eff ective fi ne-tuning of models.
					</li>
				</ul>
			</Card>
			<Card
				heading='Accenture'
				subheading='Associate Software Engineer -- Software Engineer Analyst'
				date='Sept 2021 - June 2023'
				imagePath='/src/assets/accenture_logo.png'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16 rounded-xl'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li class='text-justify'>
						Worked on a project which managed 35+ applications for Volkswagen, I was involved in developing internal tools such as alert
						monitoring system and report generation tools using Java, Spring Boot and integrating with third-party services such as Twilio
						for sending automated text messages and voice calls, and using Microsoft EWS API for sending automated emails with daily reports
						using CRON jobs.
					</li>
					<li>
						The API documentation was handled using Swagger, and the backend web service was deployed on AWS EC2 and the frontend for these
						tools was developed using Java Swing.
					</li>
				</ul>
			</Card>
		</Section>

		<Section title='Education'>
			<Card
				heading='Georgia State University'
				subheading="Master's degree, Computer Science"
				date='Aug 2023 - May 2025'
				imagePath='/src/assets/gsu_logo.jpg'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16 rounded-xl'
			/>
			<Card
				heading='Pune University'
				subheading="Bachelor's degree, Computer Engineering"
				date='Aug 2017 - June 2021'
				imagePath='/src/assets/sppu.jpg'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16 rounded-xl'
			/>
		</Section>

		<Section title='Projects'>
			<div class='flex flex-col gap-y-3 sm:flex-row sm:gap-x-3 sm:gap-y-0'>
				<ProjectCard
					href='https://www.google.com'
					heading='Consectetur'
					subheading='Lorem ipsum dolor sit amet consectetur adipisicing elit.'
					imagePath='/src/assets/coming-soon.png'
					altText='Example'
					class='w-full sm:w-1/2'
				/>
				<ProjectCard
					as='div'
					heading='Coming soon...'
					subheading=''
					imagePath='/src/assets/coming-soon.png'
					altText='Lorem, ipsum dolor sit'
					class='w-full sm:w-1/2'
				/>
			</div>
		</Section>

		<Section title='Certifications'>
			<Card
				as='a'
				heading='AWS Certified Cloud Practitioner'
				subheading='Gained foundational knowledge of AWS services, cloud concepts, billing, security, and compliance. Skilled in identifying AWS use cases and navigating the AWS Management Console.'
				date='Jan 2025 - Jan 2028'
				imagePath='/src/assets/aws_logo.png'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-11 w-auto md:-left-16 rounded-xl'
				href='https://www.credly.com/badges/c94f9592-c6e2-41e3-8b27-a39e64ac5559/public_url'
				target='_blank'
			/>
			<Card
				as='a'
				heading='Docker Foundations Professional Certificate'
				subheading='Lorem ipsum dolor sit amet consectetur adipisicing elit. Aperiam dicta.'
				date='Sep-2024'
				imagePath='/src/assets/docker.jpg'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-11 w-auto md:-left-16 rounded-xl'
				href='https://www.google.com'
				target='_blank'
			/>
		</Section>

		<Section title='Skills'>
			<SkillLayout title='Languages' skills={languages} />
			<SkillLayout title='Frontend' skills={frontend} />
			<SkillLayout title='Backend' skills={backend} />
			<SkillLayout title='Others' skills={others} />
		</Section>
	</div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PostsByYear from '../../components/PostByYear.astro';

type Projects = CollectionEntry<'projects'>;

const posts = (await getCollection('projects')).sort(
	(a: Projects, b: Projects) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Projects">
	<div
		class="max-w-5xl border-zinc-400 border-[1px] dark:bg-zinc-800 bg-zinc-300/55 flex justify-between text-gray-700 dark:text-white mx-auto p-4 sm:p-8 sm:px-12 rounded-xl"
	>
		<div class="container">
			<PostsByYear posts={posts} />
		</div>
	</div>
</Layout>
